[package]
name = "keepass-rs"
version = "0.2.0"
edition = "2021"
description = "Platform-independent KeePass database library supporting KDB and KDBX (3.1, 4.0) file formats"
license = "MIT OR MulanPSL-2.0"
keywords = ["keepass", "kdbx", "kdb", "password-manager", "crypto"]
categories = ["cryptography", "parser-implementations", "authentication"]
readme = "README.md"
homepage = "https://github.com/meission/keepass-rs"
repository = "https://github.com/meission/keepass-rs"
rust-version = "1.77"

[workspace]
members = [
    "examples/flutter_rust_bridge",
]

[dependencies]
# Crypto
# NOTE: aes/twofish are pinned to cipher 0.4-compatible lines to avoid
# pulling in cipher 0.5 (MSRV 1.85). The whole crate stays on a single
# cipher 0.4.x to satisfy the project's MSRV 1.77 guarantee.
aes = "0.8"
ctr = "0.9"
chacha20 = "0.9"
twofish = "0.7"
argon2 = "0.5"
salsa20 = "0.10"
serde = { version = "1", features = ["derive"] }
serde_bytes = "0.11"
quick-xml = "0.37"
flate2 = "1"
base64 = "0.22"
thiserror = "2"
uuid = { version = "1", features = ["v4", "serde"] }
byteorder = "1"
zeroize = { version = "1", features = ["derive"] }
log = "0.4"
hmac = "0.12"
sha2 = "0.10"
sha1 = "0.10"
chrono = "0.4"
getrandom = "0.2"
regex = "1"
p256 = { version = "0.13", features = ["ecdsa"] }
rsa = { version = "0.9", features = ["sha2"] }

[dev-dependencies]
hex = "0.4"
pretty_assertions = "1"
serde_json = "1"
criterion = "0.5"

# Benchmarks are disabled by default to keep `cargo test` / `cargo build` fast.
# Enable with: cargo bench
[[bench]]
name = "core_operations"
harness = false

[[bench]]
name = "open_save_database"
harness = false

[[bench]]
name = "crypto_kdf"
harness = false
